{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ],
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "files": [
    "src/client/MeetingMinutesButton.tsx",
    "src/client/MeetingMinutesSettingsCard.tsx",
    "src/client/index.ts",
    "src/client/locales.ts",
    "src/client/media-duration.ts",
    "src/client/settings-form.ts",
    "src/css-modules.d.ts",
    "src/types.ts",
    "src/standalone-shims.d.ts"
  ]
}
